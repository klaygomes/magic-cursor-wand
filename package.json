{
  "name": "magic-cursor-wand",
  "version": "0.3.0",
  "description": "Chalk, glitter and cloud pointer effects for the browser. Extensible effects and async configuration providers.",
  "keywords": [
    "cursor",
    "pointer",
    "effect",
    "canvas",
    "chalk",
    "glitter",
    "sparkle",
    "animation",
    "browser"
  ],
  "homepage": "https://klaygomes.github.io/magic-cursor-wand/",
  "bugs": {
    "url": "https://github.com/klaygomes/magic-cursor-wand/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klaygomes/magic-cursor-wand.git"
  },
  "license": "MIT",
  "author": "Cleiton Loiola <klaygomes@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/magic-cursor-wand.iife.js",
  "jsdelivr": "./dist/magic-cursor-wand.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "default": "./dist/providers.js"
    },
    "./cursor": {
      "types": "./dist/cursor.d.ts",
      "default": "./dist/cursor.js"
    },
    "./panel": {
      "types": "./dist/panel.d.ts",
      "default": "./dist/panel.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "vite examples",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tooling.json && tsc --noEmit -p scripts && tsc --noEmit -p examples",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "lint": "biome check .",
    "format": "biome check --write .",
    "lint:prose": "vale README.md CONTRIBUTING.md PLAN.md docs",
    "docs:api": "typedoc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "pnpm docs:api && pnpm docs:config && vitepress build docs",
    "docs:snippets": "tsc --noEmit -p docs/snippets",
    "size": "size-limit",
    "release": "pnpm build && changeset publish",
    "lint:package": "publint",
    "docs:config": "node --experimental-strip-types scripts/config-table.ts",
    "docs:integrity": "node --experimental-strip-types scripts/script-integrity.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "tweakpane": "^4.0.5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "tweakpane": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@fontsource/abel": "^5.3.0",
    "@fontsource/molengo": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@size-limit/preset-small-lib": "^14.0.1",
    "@testing-library/react": "^16.3.3",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@vitest/browser": "^5.0.2",
    "@vitest/browser-playwright": "^5.0.2",
    "@vvago/vale": "^3.23.0",
    "playwright": "^1.63.0",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.0.1",
    "tsdown": "^0.23.0",
    "tweakpane": "^4.0.5",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
